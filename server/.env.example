# Copy to ignored server/.env for local development. Never put secrets in VITE variables.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
STEMMATE_ENV=development
STEMMATE_ORIGINS=http://127.0.0.1:5173
# Set an absolute private persistent path for production.
# STEMMATE_ACCOUNTS_DB=/absolute/private/accounts.sqlite3
STEMMATE_TEACHER_INVITE=
STEMMATE_AI_HOURLY_LIMIT=60
STEMMATE_AI_USER_HOURLY_LIMIT=12
# Production only: acknowledge ONE worker/instance and completed provider/school review.
STEMMATE_SINGLE_WORKER_ACK=
STEMMATE_PROVIDER_REVIEWED=
# Leave blank. Explicitly enable only an independently reviewed, tagged index.
STEMMATE_VECTORSTORE_DIR=
